          CnZvaWQgcG93ZXJPZmYoKSB7fQoKLyoqKioqKioqKioqKioqKioqKioqKioqKioqKioqKioqKioqKioqKioqKioqKioqKioqKioq
          KioqKioqKioqKioqKioqKgoqKiBGdW5jdGlvbjogY2hlY2tSZWJvb3QKKioqKioqKioqKioqKioqKioqKioqKioqKioqKioqKioq
          KioqKioqKioqKioqKioqKioqKioqKioqKioqKioqKioqKioqKi8Kdm9pZCBjaGVja1JlYm9vdCgpIHt9Cg==
          CPPEOF
          echo "---- board .ini ----"; head -5 boards/ESP32-C5-pcb3501s/ESP32-C5-pcb3501s.ini
          echo "---- interface.cpp ----"; head -3 boards/ESP32-C5-pcb3501s/interface.cpp

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.13"

      - name: Install dependencies
        run: |
          pip install requests esptool intelhex
          pip install platformio

      - name: Apply version
        run: |
          version="${GITHUB_SHA::7}"
          sed -i "s/-DBRUCE_VERSION='\"dev\"'/-DBRUCE_VERSION='\"$version\"'/g" ./platformio.ini

      - name: Build
        run: |
          set -o pipefail
          platformio run -e "${{ env.SELECTED_ENV }}" | tee "build-${{ env.SELECTED_ENV }}.log"

      - name: Build summary (on failure too)
        if: always()
        run: |
          echo "==== last 80 log lines ===="
          tail -n 80 "build-${{ env.SELECTED_ENV }}.log" 2>/dev/null || echo "no log"
          echo "==== output bins ===="
          ls -la Bruce-*.* 2>/dev/null || echo "no Bruce bin produced"

      - name: Upload firmware
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: Bruce-${{ env.SELECTED_ENV }}
          path: Bruce-*.*
          retention-days: 7
          if-no-files-found: error
