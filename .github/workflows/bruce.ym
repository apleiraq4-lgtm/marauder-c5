name: Build Bruce - C5 PCB3501S

# Builds Bruce firmware for: XH-C5E (ESP32-C5-N16R8) + 3.5" PCB3501S (ILI9488 + XPT2046)
# Wiring = Faisal's existing hookup. Flash the resulting Bruce-*.bin at 0x0.
# Run from the Actions tab -> "Build Bruce - C5 PCB3501S" -> Run workflow (or just push).

on:
  workflow_dispatch:
  push:

env:
  BRUCE_SHA: 2b6ba4d490bfcf94ce2574c6154537dbd5838c3d   # Bruce 1.17
  SELECTED_ENV: esp32-c5-pcb3501s

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Bruce (with submodules)
        uses: actions/checkout@v4
        with:
          repository: pr3y/Bruce
          ref: ${{ env.BRUCE_SHA }}
          submodules: recursive

      - name: Add PCB3501S board files
        run: |
          mkdir -p boards/ESP32-C5-pcb3501s
          base64 -d > boards/ESP32-C5-pcb3501s/ESP32-C5-pcb3501s.ini <<'INIEOF'
          OyA9PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09
